<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Youfin</RootNamespace>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.4.0" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Web\**\*" />
    <!-- Brand assets live once in /assets and are served by the web UI -->
    <EmbeddedResource Include="..\..\assets\icon.svg" LogicalName="Jellyfin.Plugin.Youfin.Web.app.icon.svg" />
    <EmbeddedResource Include="..\..\assets\icon-180.png" LogicalName="Jellyfin.Plugin.Youfin.Web.app.icon-180.png" />
    <EmbeddedResource Include="..\..\assets\logo-dark.svg" LogicalName="Jellyfin.Plugin.Youfin.Web.app.logo-dark.svg" />
  </ItemGroup>
</Project>
